{
  "version": 1,
  "about": "Arbitration of two claims on the same resource. Ordered: first match wins, exceptions on top. No match = ESCALATE_TO_HUMAN.",
  "default_class": "routine",
  "rules": [
    {"id": "R-SAFETY", "when": {"exactly_one": {"class": "safety"}}, "then": {"winner": {"with": {"class": "safety"}}}},
    {"id": "R-DUE", "when": {"neither": {"class": "safety"}, "both_have": "due", "differ": "due"}, "then": {"winner": {"lowest": "due"}}},
    {"id": "R-FIRST", "when": {"both": {"class": "routine"}}, "then": {"winner": "first"}}
  ]
}
